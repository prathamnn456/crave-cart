# Copy this file to ".env" and fill in real values.
# On Render, set these as Environment Variables in the dashboard (do NOT commit .env).

# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Any long random string used to sign login tokens
JWT_SECRET=

# Stripe secret key (sk_test_... for testing)
STRIPE_SECRET_KEY=

# Admin panel login
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL of the deployed FRONTEND (used for Stripe redirect back after payment)
# Local: http://localhost:5173   Prod example: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Port (Render sets this automatically; leave unset in production)
PORT=4000
